# Copy to .env and fill in. .env is gitignored and must stay that way —
# SUPABASE_SERVICE_ROLE_KEY bypasses every row-level security policy, so
# anyone holding it can read and write every user's data.
#
# Do not send these values over chat or email. Add your collaborator to the
# Supabase project instead (Project Settings → Members) and let them read the
# keys from the dashboard themselves, so there is one copy per person and any
# of them can be revoked alone.

# ── Browser (safe to expose: the anon key is protected by RLS) ──────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ── Server only ────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase → Project Settings → API → service_role. Never ships to a browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Google AI Studio → API keys. Billed per call.
GEMINI_API_KEY=

# Comma-separated. The unpacked extension's id is derived from the folder path,
# so it differs per machine: read yours from chrome://extensions.
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID

# ── Optional ───────────────────────────────────────────────────────────────
# Which market a fresh visitor starts in: en | zh (default en).
DEFAULT_LANG=en
# Port the app and API share (default 3000).
PORT=3000

# Stripe, only needed to test payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Which price grants how many credits: "price_xxx:25,price_yyy:75,price_zzz:200".
# Not secret, but it names a live account's products and differs between test
# and live mode, so it is configured rather than committed.
STRIPE_PRICE_CREDITS=
VITE_STRIPE_PRICE_STARTER=
VITE_STRIPE_PRICE_PRO=
VITE_STRIPE_PRICE_MAX=
